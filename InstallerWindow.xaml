<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WsaPacman.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaPacman"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="WSA Pacman — Install"
            IsPaneToggleButtonVisible="False" />

        <Grid Grid.Row="1" Padding="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- APK Info Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="64"
                    Height="64"
                    Margin="0,0,16,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <FontIcon FontSize="32" Glyph="&#xECAA;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="AppNameText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="App Name" />
                    <TextBlock
                        x:Name="AppVersionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Version: —" />
                    <TextBlock
                        x:Name="AppPackageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Package: —" />
                </StackPanel>
            </Grid>

            <!-- Permissions list / Progress area -->
            <Grid Grid.Row="1">

                <!-- Permission list (shown before install starts) -->
                <StackPanel x:Name="PermissionsPanel" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind R.installer_message}" />
                    <ListView
                        x:Name="PermissionList"
                        IsHitTestVisible="False"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4,0,4">
                                    <FontIcon FontSize="14" Glyph="&#xE7EF;" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Progress / result (shown during and after install) -->
                <StackPanel
                    x:Name="ProgressPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="InstallProgress"
                        Width="44"
                        Height="44"
                        IsActive="True" />
                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Status InfoBar (shown on error/success) -->
            <InfoBar
                x:Name="ResultInfoBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False"
                Margin="0,8,0,0" />

            <!-- Actions row -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    x:Name="ShortcutCheckBox"
                    Grid.Column="0"
                    Content="{x:Bind R.installer_btn_checkbox_shortcut}"
                    IsChecked="True"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CancelButton"
                        AutomationProperties.AutomationId="BtnCancel"
                        AutomationProperties.Name="{x:Bind R.installer_btn_cancel}"
                        Click="Cancel_Click"
                        MinWidth="80"
                        Content="{x:Bind R.installer_btn_cancel}" />
                    <Button
                        x:Name="InstallButton"
                        AutomationProperties.AutomationId="BtnInstall"
                        Click="Install_Click"
                        Content="{x:Bind InstallButtonLabel}"
                        MinWidth="100"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
