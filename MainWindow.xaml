<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WsaPacman.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaPacman"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="WSA Package Manager"
            Subtitle="v1.6.0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <x:Double x:Key="NavigationViewTopPaneHeight">50</x:Double>
                <!-- NavigationViewItemSeparator's Fill is hardcoded to these theme keys in its
                     ControlTemplate (not a TemplateBinding), so Background on the element itself
                     has no effect — override the resources instead. Top mode uses the "Top*" key.
                     Matches Flutter's theme.inactiveColor.withOpacity(0.3) (main.dart:701). -->
                <SolidColorBrush x:Key="TopNavigationViewItemSeparatorForeground" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.3" />
                <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{ThemeResource TextFillColorDisabled}" Opacity="0.3" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel
                    Margin="12,0,20,0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Image
                        Width="24"
                        Height="24"
                        Source="Assets/logo.png"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Style="{StaticResource BodyLargeTextBlockStyle}"
                        Text="WSA PacMan"
                        VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavItemWsa"
                    AutomationProperties.Name="WSA"
                    IsSelected="True"
                    Tag="wsa">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="ms-appx:///Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons"
                                FontSize="18"
                                Glyph="&#xF0032;"
                                VerticalAlignment="Center" />
                            <TextBlock Text="WSA" VerticalAlignment="Center" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavItemUninstall"
                    AutomationProperties.Name="Uninstall"
                    Tag="uninstall">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" FontSize="18" Glyph="&#xF34D;" VerticalAlignment="Center" />
                            <TextBlock Text="Uninstall" VerticalAlignment="Center" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- Vertical divider before the settings tab (Flutter main.dart:694-704).
                     NavigationViewItemHeader is not rendered in PaneDisplayMode="Top", so
                     the built-in separator control is used instead. -->
                <NavigationViewItemSeparator
                    Height="16"
                    Margin="8,0"
                    VerticalAlignment="Center" />
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavItemSettings"
                    AutomationProperties.Name="{x:Bind R.screen_settings}"
                    Tag="settings">
                    <NavigationViewItem.Content>
                        <FontIcon FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" FontSize="18" Glyph="&#xF6AA;" VerticalAlignment="Center" />
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
