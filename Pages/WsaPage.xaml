<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WsaPacman.Pages.WsaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaPacman.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="0">

            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind R.screen_wsa}" />

            <!-- WSA Status InfoBar -->
            <Border
                x:Name="StatusInfoBar"
                Margin="0,0,0,28"
                Padding="14"
                Background="{ThemeResource StatusConnectingBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Severity icon, top-aligned -->
                    <FontIcon
                        x:Name="StatusIcon"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE946;" />

                    <!-- Title (row 1) + description/action row (row 2) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock
                            x:Name="StatusTitleText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind R.status_unknown}" />

                        <controls:WrapPanel
                            Margin="0,8,0,0"
                            HorizontalSpacing="8"
                            VerticalSpacing="6">
                            <TextBlock
                                x:Name="StatusMessageText"
                                VerticalAlignment="Center"
                                Text="{x:Bind R.status_unknown_desc}"
                                TextWrapping="Wrap" />

                            <Button
                                AutomationProperties.AutomationId="BtnRefreshStatus"
                                AutomationProperties.Name="{x:Bind R.btn_refresh_status}"
                                Click="RefreshStatus_Click"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="{x:Bind R.btn_refresh_status}" />
                                </StackPanel>
                            </Button>
                        </controls:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Android Management Section -->
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind R.wsa_manage}" />

            <!-- Manage Applications Card -->
            <Button
                AutomationProperties.AutomationId="BtnManageApps"
                AutomationProperties.Name="{x:Bind R.wsa_manage_app}"
                Click="ManageApps_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,5"
                MinHeight="68"
                Padding="16,0,16,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,17,0"
                        FontFamily="ms-appx:///Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons"
                        FontSize="24"
                        Glyph="&#xF0032;"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind R.wsa_manage_app}"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="11"
                        Glyph="&#xE76C;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Manage Settings Card -->
            <Button
                AutomationProperties.AutomationId="BtnManageSettings"
                AutomationProperties.Name="{x:Bind R.wsa_manage_settings}"
                Click="ManageSettings_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                MinHeight="68"
                Padding="16,0,16,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,17,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="24"
                        Glyph="&#xE713;"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind R.wsa_manage_settings}"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="11"
                        Glyph="&#xE76C;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>
