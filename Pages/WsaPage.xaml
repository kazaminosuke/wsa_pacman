<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WsaPacman.Pages.WsaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaPacman.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,24,24,24" Spacing="0">

            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind R.screen_wsa}" />

            <!-- WSA Status InfoBar -->
            <Border
                x:Name="StatusInfoBar"
                Margin="0,0,0,28"
                Padding="10"
                Background="{ThemeResource StatusConnectingBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0.5"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Severity icon, top-aligned -->
                    <FontIcon
                        x:Name="StatusIcon"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE946;" />

                    <!-- Title (row 1) + description/action row (row 2) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock
                            x:Name="StatusTitleText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind R.status_unknown}" />

                        <controls:WrapPanel
                            Margin="0,6,0,0"
                            HorizontalSpacing="8"
                            VerticalSpacing="6">
                            <TextBlock
                                x:Name="StatusMessageText"
                                VerticalAlignment="Center"
                                Text="{x:Bind R.status_unknown_desc}"
                                TextWrapping="Wrap" />

                            <!-- MISSING: link to WSABuilds -->
                            <Button
                                x:Name="BtnWsaBuilds"
                                AutomationProperties.AutomationId="BtnWsaBuilds"
                                AutomationProperties.Name="{x:Bind R.btn_wsabuilds}"
                                Click="WsaBuilds_Click"
                                Padding="12,6,12,6"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE896;" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_wsabuilds}" />
                                </StackPanel>
                            </Button>

                            <!-- ARRESTED: launch WSA -->
                            <Button
                                x:Name="BtnLaunchWsa"
                                AutomationProperties.AutomationId="BtnLaunchWsa"
                                AutomationProperties.Name="{x:Bind R.btn_launch_wsa}"
                                Click="LaunchWsa_Click"
                                Padding="12,6,12,6"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE768;" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_launch_wsa}" />
                                </StackPanel>
                            </Button>

                            <!-- OFFLINE / DISCONNECTED / UNKNOWN: restart WSA -->
                            <Button
                                x:Name="BtnRestartWsa"
                                AutomationProperties.AutomationId="BtnRestartWsa"
                                AutomationProperties.Name="{x:Bind R.btn_restart_wsa}"
                                Click="RestartWsa_Click"
                                Padding="12,6,12,6"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE777;" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_restart_wsa}" />
                                </StackPanel>
                            </Button>

                            <!-- UNAUTHORIZED: authorize -->
                            <Button
                                x:Name="BtnAuth"
                                AutomationProperties.AutomationId="BtnAuth"
                                AutomationProperties.Name="{x:Bind R.btn_auth}"
                                Click="Auth_Click"
                                Padding="12,6,12,6"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72E;" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_auth}" />
                                </StackPanel>
                            </Button>

                            <!-- OFFLINE / DISCONNECTED / UNKNOWN / UNAUTHORIZED: WSA developer settings -->
                            <Button
                                x:Name="BtnDevSettings"
                                AutomationProperties.AutomationId="BtnDevSettings"
                                AutomationProperties.Name="{x:Bind R.btn_dev_settings}"
                                Click="DevSettings_Click"
                                Padding="12,6,12,6"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xEC7A;" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_dev_settings}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="BtnRefreshStatus"
                                AutomationProperties.AutomationId="BtnRefreshStatus"
                                AutomationProperties.Name="{x:Bind R.btn_refresh_status}"
                                Click="RefreshStatus_Click"
                                Padding="12,6,12,6"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="RefreshIcon" FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72C;" />
                                    <!-- Swapped in for the icon while refreshing / WSA starting (W18) -->
                                    <ProgressRing
                                        x:Name="RefreshRing"
                                        Width="14"
                                        Height="14"
                                        MinWidth="14"
                                        MinHeight="14"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <TextBlock FontWeight="Bold" FontSize="13" Text="{x:Bind R.btn_refresh_status}" />
                                </StackPanel>
                            </Button>
                        </controls:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Android Management Section -->
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource BodyLargeTextBlockStyle}"
                Text="{x:Bind R.wsa_manage}" />

            <!-- Manage Applications Card -->
            <Button
                AutomationProperties.AutomationId="BtnManageApps"
                AutomationProperties.Name="{x:Bind R.wsa_manage_app}"
                Click="ManageApps_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,5"
                MinHeight="68"
                Padding="20,0,16,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0.5"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,17,0"
                        FontFamily="ms-appx:///Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons"
                        FontSize="24"
                        Glyph="&#xF0032;"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind R.wsa_manage_app}"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="11"
                        Glyph="&#xE76C;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Manage Settings Card -->
            <Button
                AutomationProperties.AutomationId="BtnManageSettings"
                AutomationProperties.Name="{x:Bind R.wsa_manage_settings}"
                Click="ManageSettings_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                MinHeight="68"
                Padding="20,0,16,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0.5"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,0,17,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="24"
                        Glyph="&#xE713;"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind R.wsa_manage_settings}"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="11"
                        Glyph="&#xE76C;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>
