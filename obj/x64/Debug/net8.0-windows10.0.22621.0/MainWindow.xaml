<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WsaPacman.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WSA Package Manager">

    <!-- Mica バックドロップ (Windows 11 のみ有効、他では無視される) -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <!-- Grid は Panel を継承しており FontFamily プロパティを持たないため、
         フォントは App.xaml の ContentControlThemeFontFamily リソースで一括設定する -->
    <Grid>
        <!--
            NavigationView を PaneDisplayMode="Top" で使用。
            PaneHeader にロゴ＋タイトルを配置し、そこをドラッグ領域として SetTitleBar() に渡す。
            システムボタン（最小化/最大化/閉じる）は Windows が右端にオーバーレイ描画する。
        -->
        <NavigationView x:ConnectionId='2'
            x:Name="NavView"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionFollowsFocus="Disabled"
            CompactModeThresholdWidth="0"
                                                       
                                   >

            <!--
                PaneHeader: ロゴ＋アプリ名
                このグリッドをタイトルバーのドラッグ領域として使用する
                (コードビハインドで SetTitleBar(AppTitleBar) を呼ぶ)
            -->
            <NavigationView.PaneHeader>
                <Grid x:ConnectionId='3' x:Name="AppTitleBar" MinWidth="190" VerticalAlignment="Stretch">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,20,0"
                        Spacing="10">
                        <!-- アプリアイコン (将来的に Image に差し替え) -->
                        <FontIcon
                            Glyph="&#xE80B;"
                            FontSize="18"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="WSA PacMan"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            FontFamily="Yu Gothic UI, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- メインナビゲーション項目 -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:ConnectionId='4'
                    x:Name="NavWSA"
                    Content="WSA"
                    Tag="WsaPage">
                    <NavigationViewItem.Icon>
                        <!-- Android に最も近い Segoe MDL2 Assets グリフ -->
                        <FontIcon Glyph="&#xE80B;" FontSize="16"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:ConnectionId='5'
                    x:Name="NavUninstall"
                    Content="Uninstall"
                    Tag="UninstallPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Delete"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- フッター項目 (設定タブ) -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:ConnectionId='6'
                    x:Name="NavSettings"
                    Content="設定"
                    Tag="SettingsPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ページコンテンツを表示する Frame -->
            <Frame x:ConnectionId='7' x:Name="ContentFrame" IsNavigationStackEnabled="False"/>
        </NavigationView>
    </Grid>
</Window>

