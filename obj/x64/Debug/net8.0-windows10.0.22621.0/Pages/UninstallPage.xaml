<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WsaPacman.Pages.UninstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Yu Gothic UI, Segoe UI">

    <Grid Margin="24,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ページタイトル -->
        <TextBlock
            Grid.Row="0"
            Text="Uninstall"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="0,16,0,16"/>

        <!-- ── アクションバー ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource SettingCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- スキャンボタン -->
                <Button x:ConnectionId='7'
                    Grid.Column="0"
                    x:Name="BtnScan"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,8"
                                         >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Find"/>
                        <TextBlock x:ConnectionId='10' x:Name="BtnScanText" Text="スキャン"/>
                    </StackPanel>
                </Button>

                <!-- レジストリバックアップボタン -->
                <Button x:ConnectionId='8'
                    Grid.Column="1"
                    x:Name="BtnBackupRegistry"
                    IsEnabled="False"
                    Margin="10,0,0,0"
                    Padding="14,8"
                                                   >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save"/>
                        <TextBlock Text="レジストリのバックアップ"/>
                    </StackPanel>
                </Button>

                <!-- クリーンアップ実行ボタン (右端、危険操作スタイル) -->
                <Button x:ConnectionId='9'
                    Grid.Column="3"
                    x:Name="BtnCleanup"
                    IsEnabled="False"
                    Padding="14,8"
                    Foreground="Red"
                                            >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Delete"/>
                        <TextBlock Text="クリーンアップ実行"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── コンテンツエリア ────────────────────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- 空状態 / スキャン中 / WSA未インストール時のメッセージ -->
            <StackPanel x:ConnectionId='2'
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing x:ConnectionId='5'
                    x:Name="ScanProgressRing"
                    IsActive="False"
                    Visibility="Collapsed"
                    Width="44"
                    Height="44"/>
                <TextBlock x:ConnectionId='6'
                    x:Name="EmptyStateText"
                    Text="スキャンボタンを押してゴーストアプリを検出してください"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- スキャン結果リスト -->
            <ScrollViewer x:ConnectionId='3'
                x:Name="ResultsScrollViewer"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,16">
                <StackPanel x:ConnectionId='4' x:Name="ResultsPanel" Spacing="6">
                    <!--
                        実装時: スキャン結果をここに動的に追加する。
                        各アイテムは _BuildAppListItem() で生成する BorderPanel を挿入する。
                        骨格ではプレースホルダーとして 2 件のサンプルを表示する。
                    -->

                    <!-- サンプルアイテム 1 -->
                    <Border Style="{StaticResource AppListCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE80B;"
                                FontSize="28"
                                VerticalAlignment="Center"
                                Foreground="Green"
                                Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="サンプルアプリ (ADB)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="com.example.sampleapp" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- サンプルアイテム 2 -->
                    <Border Style="{StaticResource AppListCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE7EE;"
                                FontSize="28"
                                VerticalAlignment="Center"
                                Foreground="Orange"
                                Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ゴーストアプリ (レジストリ)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="com.example.ghostapp" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>

