<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WsaPacman.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Yu Gothic UI, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,32" Spacing="4">

            <!-- ページタイトル -->
            <TextBlock
                Text="設定"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,16,0,16"/>

            <!-- ═══════════════════════════════════════════════════════════════
                 接続設定
            ═══════════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="接続"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="4,4,0,4"/>

            <!-- ADB ポート -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE701;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" Text="ADB ポート" VerticalAlignment="Center" FontSize="14"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="127.0.0.1 :" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <NumberBox x:ConnectionId='37'
                            x:Name="AndroidPortBox"
                            Value="58526"
                            Minimum="1"
                            Maximum="65535"
                            SpinButtonPlacementMode="Compact"
                            Width="120"
                                                                      />
                        <Button x:ConnectionId='38'
                            ToolTipService.ToolTip="デフォルトに戻す (58526)"
                            Padding="6"
                                                      >
                            <SymbolIcon Symbol="Refresh"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 動作設定
            ═══════════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="動作"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="4,12,0,4"/>

            <!-- WSA 自動起動 -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WSA を自動起動" FontSize="14"/>
                        <TextBlock Text="APK インストール時に WSA が停止中であれば自動で起動します" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:ConnectionId='36'
                        Grid.Column="2"
                        x:Name="AutostartToggle"
                        Margin="0"
                        OnContent=""
                        OffContent=""
                                                         />
                </Grid>
            </Border>

            <!-- レジストリ自動バックアップ -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" Symbol="Save" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="アンインストール前にレジストリを自動バックアップ" FontSize="14"/>
                        <TextBlock Text="クリーンアップ実行前にレジストリを自動保存します" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:ConnectionId='35'
                        Grid.Column="2"
                        x:Name="AutoBackupToggle"
                        Margin="0"
                        OnContent=""
                        OffContent=""
                                                          />
                </Grid>
            </Border>

            <!-- インストールタイムアウト -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='34' x:Name="TimeoutLabel" Text="インストールタイムアウト: 60 秒" FontSize="14"/>
                        <TextBlock Text="0 で無制限" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Slider x:ConnectionId='33'
                        Grid.Column="2"
                        x:Name="TimeoutSlider"
                        Minimum="0"
                        Maximum="120"
                        Value="60"
                        TickFrequency="15"
                        TickPlacement="Outside"
                        VerticalAlignment="Center"
                                                                 />
                </Grid>
            </Border>

            <!-- バックアップ保存先 -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" Symbol="Folder" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="バックアップ保存先" FontSize="14"/>
                        <TextBlock x:ConnectionId='32'
                            x:Name="BackupDirText"
                            Text="%USERPROFILE%\Desktop"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='30'
                            x:Name="BtnResetBackupDir"
                            ToolTipService.ToolTip="デスクトップにリセット"
                            Padding="6"
                            Visibility="Collapsed"
                                                           >
                            <SymbolIcon Symbol="Clear"/>
                        </Button>
                        <Button x:ConnectionId='31'
                            x:Name="BtnBrowseBackupDir"
                            Padding="12,6"
                                                            >
                            <TextBlock Text="参照" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 表示設定
            ═══════════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="表示"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="4,12,0,4"/>

            <!-- 言語 -->
            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" Text="言語" VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox x:ConnectionId='29'
                        Grid.Column="2"
                        x:Name="LanguageComboBox"
                        HorizontalAlignment="Stretch"
                                                                            >
                        <ComboBoxItem Content="システム" IsSelected="True"/>
                        <ComboBoxItem Content="日本語 (ja)"/>
                        <ComboBoxItem Content="English (en)"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- テーマ -->
            <Expander x:ConnectionId='2'
                x:Name="ThemeExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Margin="0,0,0,4">
                <Expander.Header>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE793;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" Text="テーマモード" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Margin="36,8,0,4">
                    <RadioButton x:ConnectionId='26' x:Name="ThemeSystem"  Content="システム設定に従う" GroupName="ThemeGroup" IsChecked="True"                             />
                    <RadioButton x:ConnectionId='27' x:Name="ThemeLight"   Content="ライト"             GroupName="ThemeGroup"                             />
                    <RadioButton x:ConnectionId='28' x:Name="ThemeDark"    Content="ダーク"             GroupName="ThemeGroup"                             />
                </StackPanel>
            </Expander>

            <!-- アクセントカラー -->
            <Expander x:ConnectionId='3'
                x:Name="AccentExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Margin="0,0,0,4">
                <Expander.Header>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" Text="アクセントカラー" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Margin="36,8,0,8">
                    <!-- カラーパレット (丸いボタン) -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- システム (OS アクセントカラー) -->
                        <Button x:ConnectionId='16' x:Name="ColorSystem"  Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="システム"                         Tag="System"  Background="#0078D4"/>
                        <Button x:ConnectionId='17' x:Name="ColorDefault" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="デフォルト"                        Tag="Default" Background="#2D7D6F"/>
                        <Button x:ConnectionId='18' x:Name="ColorYellow"  Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="イエロー"                         Tag="Yellow"  Background="#FFB900"/>
                        <Button x:ConnectionId='19' x:Name="ColorOrange"  Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="オレンジ"                         Tag="Orange"  Background="#F7630C"/>
                        <Button x:ConnectionId='20' x:Name="ColorRed"     Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="レッド"                           Tag="Red"     Background="#E74856"/>
                        <Button x:ConnectionId='21' x:Name="ColorMagenta" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="マゼンタ"                         Tag="Magenta" Background="#BF0077"/>
                        <Button x:ConnectionId='22' x:Name="ColorPurple"  Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="パープル"                         Tag="Purple"  Background="#744DA9"/>
                        <Button x:ConnectionId='23' x:Name="ColorBlue"    Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="ブルー"                           Tag="Blue"    Background="#0078D4"/>
                        <Button x:ConnectionId='24' x:Name="ColorTeal"    Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="ティール"                         Tag="Teal"    Background="#038387"/>
                        <Button x:ConnectionId='25' x:Name="ColorGreen"   Width="32" Height="32" CornerRadius="16" Padding="0" ToolTipService.ToolTip="グリーン"                         Tag="Green"   Background="#107C10"/>
                    </StackPanel>
                    <!-- カスタムカラー (将来的にカラーピッカーを表示) -->
                    <Button x:ConnectionId='14' x:Name="BtnCustomColor"                              Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='15' x:Name="CustomColorPreview" Width="16" Height="16" Fill="#0078D4"/>
                            <TextBlock Text="カスタムカラー…"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <!-- Mica (Windows 11 のみ表示する想定) -->
            <Expander x:ConnectionId='4'
                x:Name="MicaExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Margin="0,0,0,4">
                <Expander.Header>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE81A;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" Text="背景エフェクト (Mica)" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Margin="36,8,0,4">
                    <RadioButton x:ConnectionId='11' x:Name="MicaDisabled" Content="無効 (ソリッドカラー)"     GroupName="MicaGroup"                            />
                    <RadioButton x:ConnectionId='12' x:Name="MicaEnabled"  Content="Mica (Base) — 標準"        GroupName="MicaGroup" IsChecked="True"                            />
                    <RadioButton x:ConnectionId='13' x:Name="MicaAlt"      Content="Mica Alt — より濃い Mica"  GroupName="MicaGroup"                            />
                </StackPanel>
            </Expander>

            <!-- アイコンスタイル -->
            <Expander x:ConnectionId='5'
                x:Name="IconExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Margin="0,0,0,4">
                <Expander.Header>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE91B;" FontSize="{StaticResource SettingIconSize}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" Text="アダプティブアイコン" VerticalAlignment="Center" FontSize="14"/>
                        <!-- ヘッダー内トグルスイッチ (レガシーアイコンのオン/オフ) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
                            <TextBlock x:ConnectionId='6' x:Name="LegacyIconLabel" Text="オン" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ToggleSwitch x:ConnectionId='7'
                                x:Name="LegacyIconToggle"
                                IsOn="True"
                                Margin="0"
                                OnContent=""
                                OffContent=""
                                                                  />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Margin="36,8,0,4">
                    <RadioButton x:ConnectionId='8' x:Name="IconCircle"    Content="円形"         GroupName="IconGroup" IsChecked="True"                            />
                    <RadioButton x:ConnectionId='9' x:Name="IconRounded"   Content="角丸正方形"   GroupName="IconGroup"                            />
                    <RadioButton x:ConnectionId='10' x:Name="IconSquircle"  Content="スクワークル" GroupName="IconGroup"                            />
                </StackPanel>
            </Expander>

            <!-- ── アプリ情報 ──────────────────────────────────────────────────── -->
            <TextBlock
                Text="情報"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="4,12,0,4"/>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="WSA Package Manager" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="バージョン 1.6.0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

