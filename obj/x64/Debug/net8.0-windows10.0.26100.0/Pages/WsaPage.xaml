<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WsaPacman.Pages.WsaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Yu Gothic UI, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,32">

            <!-- ページタイトル -->
            <TextBlock
                Text="WSA"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,16,0,16"/>

            <!-- ── 接続ステータス InfoBar ──────────────────────────────────────── -->
            <!--
                実装時: WSAPeriodicConnector の ConnectionStatus に応じて
                Severity / Title / Content の内容を切り替える。
                骨格では "UNKNOWN" 状態を固定表示。
            -->
            <InfoBar x:ConnectionId='2'
                x:Name="StatusInfoBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="ステータス不明"
                Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,8">
                    <TextBlock x:ConnectionId='5'
                        x:Name="StatusDescription"
                        Text="WSAの接続状態を確認中です。"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"/>

                    <!-- WSA起動ボタン (ARRESTED / OFFLINE 時のみ有効) -->
                    <Button x:ConnectionId='6'
                        x:Name="BtnLaunchWSA"
                        IsEnabled="False"
                        Padding="12,6"
                                                  >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="WSAを起動" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- 再接続ボタン (OFFLINE / DISCONNECTED 時) -->
                    <Button x:ConnectionId='7'
                        x:Name="BtnRestartWSA"
                        Visibility="Collapsed"
                        Padding="12,6"
                                                   >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="WSAを再起動" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- 開発者設定ボタン (OFFLINE / DISCONNECTED 時) -->
                    <Button x:ConnectionId='8'
                        x:Name="BtnDevSettings"
                        Visibility="Collapsed"
                        Padding="12,6"
                                                    >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Setting" Width="14" Height="14"/>
                            <TextBlock Text="開発者設定" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- ステータス更新ボタン (常時表示) -->
                    <Button x:ConnectionId='9'
                        x:Name="BtnRefreshStatus"
                        Padding="12,6"
                                                      >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 更新中は ProgressRing、通常時は更新アイコン -->
                            <ProgressRing x:ConnectionId='10'
                                x:Name="RefreshRing"
                                IsActive="False"
                                Width="14"
                                Height="14"
                                Visibility="Collapsed"/>
                            <FontIcon x:ConnectionId='11'
                                x:Name="RefreshIcon"
                                Glyph="&#xE72C;"
                                FontSize="14"
                                VerticalAlignment="Center"/>
                            <TextBlock Text="更新" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </InfoBar>

            <!-- ── WSA 管理セクション ──────────────────────────────────────────── -->
            <TextBlock
                Text="WSAの管理"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                FontSize="15"
                Margin="0,0,0,12"/>

            <!--
                アプリケーションの管理カード
                WSA 未インストール/未接続時は IsEnabled="False"
            -->
            <Button x:ConnectionId='3'
                x:Name="BtnManageApp"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="False"
                Margin="0,0,0,6"
                Padding="16,13"
                                          >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE80B;"
                        FontSize="24"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="アプリケーションの管理"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            Text="インストール済みの Android アプリを管理します"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,2,0,0"/>
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        Glyph="&#xE76C;"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Button>

            <!--
                設定の管理カード
                WSA 未インストール/未接続時は IsEnabled="False"
            -->
            <Button x:ConnectionId='4'
                x:Name="BtnManageSettings"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="False"
                Padding="16,13"
                                               >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <SymbolIcon
                        Grid.Column="0"
                        Symbol="Setting"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="設定の管理"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            Text="WSA の Android 設定を開きます"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,2,0,0"/>
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        Glyph="&#xE76C;"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>

