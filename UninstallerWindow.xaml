<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WsaPacman.UninstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaPacman"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid Padding="20,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: 30×30 icon + screen name (drag region for the borderless window) -->
            <Grid x:Name="HeaderArea" Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center">
                    <FontIcon FontSize="26" Glyph="&#xECAA;" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind R.screen_uninstall}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Content: confirm or progress -->
            <Grid Grid.Row="1">

                <!-- Confirm state: confirmation sentence (18px) + 8px + package line (X3) -->
                <StackPanel x:Name="ConfirmPanel" Spacing="8">
                    <TextBlock
                        x:Name="ConfirmText"
                        Style="{StaticResource BodyLargeTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PackageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="com.example.app"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <!-- Processing / done state -->
                <StackPanel
                    x:Name="ProgressPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="UninstallProgress"
                        Width="44"
                        Height="44"
                        IsActive="True" />
                    <!-- Swapped in for the ring when the uninstall finishes (X7) -->
                    <FontIcon
                        x:Name="DoneIcon"
                        FontSize="48"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="15">
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="BtnCancel"
                    AutomationProperties.Name="{x:Bind R.installer_btn_cancel}"
                    Click="Cancel_Click"
                    Content="{x:Bind R.installer_btn_cancel}"
                    MinWidth="80" />
                <!-- Red filled button (Flutter: FilledButton red / hover=light / pressed=dark, white text) -->
                <Button
                    x:Name="UninstallButton"
                    AutomationProperties.AutomationId="BtnUninstall"
                    AutomationProperties.Name="{x:Bind R.uninstaller_btn_yes}"
                    Click="Uninstall_Click"
                    Content="{x:Bind R.uninstaller_btn_yes}"
                    MinWidth="80">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D13438" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A4262C" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
