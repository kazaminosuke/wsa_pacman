<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WsaPacman.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WsaPacman">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- WSA connection status card backgrounds, one per severity -->
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                    <SolidColorBrush x:Key="PermissionListBackgroundBrush" Color="#08000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                    <SolidColorBrush x:Key="PermissionListBackgroundBrush" Color="#0CFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                    <StaticResource x:Key="PermissionListBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Yu Gothic UI</FontFamily>
            <!-- TextBlock does not inherit ContentControlThemeFontFamily; force via implicit style.
                 Also applies the Body (14/20) line-height so unstyled TextBlocks (no explicit
                 Style="{StaticResource ...}") match the ramp too, same reasoning as the named
                 styles below. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <!-- fluent_ui typography.bodyLarge (18px Regular) — not part of the WinUI system ramp -->
            <Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>

            <!--
                WinUI's built-in *TextBlockStyle resources (generic.xaml) only set FontSize;
                they never set LineHeight, so LineStackingStrategy stays at its default
                "MaxHeight" and text renders tighter than the official Windows 11 type ramp.
                fluent_ui's typography (Flutter's design source) explicitly encodes the ramp's
                line-height per style (e.g. body 14/20, title 28/36), which is why Flutter
                screens read as more spaced-out. Re-declaring these styles with the same key
                (BasedOn pointing at itself resolves to the framework's version) adds the
                missing LineHeight so both platforms match.
            -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="LineHeight" Value="28" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
