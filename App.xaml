<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WsaPacman.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WsaPacman">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- WSA connection status card backgrounds, one per severity -->
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="StatusConnectingBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
                    <StaticResource x:Key="StatusSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
