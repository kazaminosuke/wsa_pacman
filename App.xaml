<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WsaPacman.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Yu Gothic UI をアプリ全体のデフォルトフォントに設定
                 FontFamily 型で上書きしないとコントロールテンプレートに反映されない -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Yu Gothic UI, Segoe UI</FontFamily>

            <!-- カード型 Border 共通スタイル -->
            <Style x:Key="SettingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- 設定項目の leading アイコンサイズ -->
            <x:Double x:Key="SettingIconSize">22</x:Double>

            <!-- ホバー時のカードスタイル (Uninstall ページのリストアイテム用) -->
            <Style x:Key="AppListCardStyle" TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
